// Build.Flow - schema v2 (PostgreSQL)
// Regra de ouro: imagens/arquivos NUNCA viram blob. So o caminho (String).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// CONFIGURACAO DE PRAZOS POR ETAPA (Gestao > Etapas)
// ===========================================================================

// Tempo limite (em minutos) que um pedido deve permanecer em cada status do
// Fluxo de Pedidos. Usado para colorir os cards: >=50% do limite = amarelo
// (aviso), > limite = vermelho (alerta). Um registro por status (unico).
model StageTimeLimit {
  id        String      @id @default(cuid())
  status    OrderStatus @unique
  // Limite em minutos. null/0 = sem alerta para este status.
  limitMinutes Int       @default(0)
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
}

// ===========================================================================
// USUARIOS / PERFIS
// ===========================================================================

enum Role {
  GESTAO
  VENDAS
  FINANCEIRO
  LOGISTICA
  MOTORISTA
}

// Modelo de venda do vendedor: trava o escopo de tudo que ele vende.
enum SalesModel {
  VAREJO
  ATACADO
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  // Obrigatorio para VENDAS; null para os demais perfis.
  salesModel SalesModel?
  // Chave PIX do MOTORISTA (para o pagamento de entregas pelo Financeiro).
  // Opcional; so faz sentido para o perfil MOTORISTA (validado na action).
  pixKey    String?
  // Telefone do MOTORISTA. Guardado SEMPRE como digitos com DDD e sem o
  // codigo do pais (ex.: "11988887777") — a formatacao com mascara e so de
  // exibicao. Normalizar na gravacao evita ter de limpar a base depois, quando
  // o numero for consumido por um envio automatico.
  // Opcional; so faz sentido para o perfil MOTORISTA (validado na action).
  phone     String?
  // Código opaco de indicação da vendedora de ATACADO. NÃO é o id: um
  // ?v=<userId> vazaria ids internos, seria enumerável e deixaria qualquer
  // pessoa apontar submissões para qualquer vendedora (decisão 13). Opaco e
  // único para poder ser rotacionado se vazar.
  referralCode String? @unique
  active    Boolean  @default(true)
  // Versão da sessão. O JWT carrega este número; qualquer incremento invalida
  // TODOS os tokens já emitidos (logout server-side real, expulsão de usuário
  // desativado, "sair de todos os dispositivos"). Sem isto, um JWT roubado
  // valeria pelos 7 dias inteiros mesmo após logout.
  tokenVersion Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersAsSeller Order[]        @relation("OrderSeller")
  deliveries     Delivery[]     @relation("DeliveryDriver")
  notifications  Notification[]
  salesGoals     SalesGoal[]
  rankAdjustments RankAdjustment[]
  dailyTasks     DailyTask[]
  // "Lojas de Origem" atreladas ao usuario (max 2, validado na action).
  // Usado por VENDAS para escopo de criacao e por quem opera o fluxo por loja.
  originStores   OriginStore[]  @relation("UserOriginStores")
  pushSubscriptions PushSubscription[]
  driverPayments   DriverPayment[] @relation("DriverPaymentDriver")
  transportRequests TransportRequest[] @relation("TransportDriver")
  selectContracts   SelectContract[]   @relation("SelectResponsible")
  wholesaleLeads        WholesaleLead[]      @relation("WholesaleLeadSeller")
  wholesaleLeadsDecided WholesaleLead[]      @relation("WholesaleLeadDecider")
  wholesaleLeadEvents   WholesaleLeadEvent[] @relation("WholesaleLeadEventActor")

  @@index([role])
}

// Inscrição de Web Push (Push API) de um dispositivo/navegador do usuário.
// Guarda o endpoint do serviço de push do navegador + chaves de criptografia
// (p256dh/auth) necessárias para o web-push cifrar a mensagem. Uma por
// dispositivo; o mesmo usuário pode ter várias (celular, desktop, etc.).
// NÃO guardamos payload aqui — só o "endereço" para onde enviar o push.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===========================================================================
// CADASTROS DE APOIO (gerenciados pela Gestao)
// ===========================================================================

model Store {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

// "Loja de Origem": conceito NOVO e separado do Store acima.
// - Cadastravel pela Gestao (as 4 iniciais vem do seed).
// - simplifiedFlow=true => fluxo Pago -> Embalado -> Entregue, sem NF,
//   comprovante obrigatorio (Iguatemi, Sao Paulo, Lov Club).
// - Relacao N-N com User (max 2 por usuario, validado na action).
model OriginStore {
  id             String   @id @default(cuid())
  name           String
  simplifiedFlow Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  users  User[]  @relation("UserOriginStores")
  orders Order[]
}

model OrderType {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Operation {
  id        String   @id @default(cuid())
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model ShippingMethod {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  // Quando true, o formulário de Vendas exige o endereço de entrega completo
  // (CEP, logradouro, número, bairro, cidade, UF) e habilita a etiqueta
  // térmica. Usado pela forma de envio "Excursão". Default false = sem
  // endereço (comportamento das demais formas de envio).
  requiresAddress Boolean @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
  selectPayments SelectPayment[]
}

model Bank {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orders Order[]
  selectPayments SelectPayment[]
}

// CNPJ da empresa (cadastro do Financeiro). Vinculado ao pedido na analise.
model Cnpj {
  id        String   @id @default(cuid())
  // Razao social / apelido para exibir no select.
  name      String
  // Numero do CNPJ (somente digitos ou formatado). Unico.
  document  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  selectPayments SelectPayment[]

  @@index([active])
}

model PaymentStatusOption {
  id          String             @id @default(cuid())
  name        String
  disposition PaymentDisposition
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  orders      Order[]
}

enum PaymentDisposition {
  APROVA
  INTERROMPE
}

// ===========================================================================
// CLIENTES
// ===========================================================================

model Customer {
  id        String   @id @default(cuid())
  // Codigo do cliente (unico, obrigatorio).
  code      String   @unique
  name      String
  // Dados de localizacao e contato (todos opcionais). Usados para
  // pre-preencher o Endereco de Entrega no Novo Pedido (forma Excursao).
  cep       String?
  street    String? // Logradouro
  district  String? // Bairro
  city      String?
  state     String? // UF (2 letras)
  contact   String? // Telefone / E-mail / Responsavel (texto livre)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  selectContracts SelectContract[]

  @@index([name])
}

// "Excursao": ponto de entrega coletivo (padrao visual do cadastro de
// Clientes). Selecionavel no Novo Pedido quando a forma de envio e a de
// Excursao (ShippingMethod.requiresAddress = true). Ao escolher, o endereco
// da excursao pre-preenche os campos ship* do pedido (editaveis).
model Excursao {
  id          String   @id @default(cuid())
  name        String
  address     String
  // "Funciona ate as" (horario limite). Texto livre (ex.: "18:00").
  cutoffTime  String?
  // Dias de funcionamento (texto livre, ex.: "Seg a Sex").
  operatingDays String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([name])
}

// ===========================================================================
// PRODUTOS / ESTOQUE
// ===========================================================================

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([active])
}

// ===========================================================================
// PEDIDOS
// ===========================================================================

enum OrderStatus {
  EM_ANALISE
  // Fluxo simplificado (Loja de Origem): apos o Financeiro clicar "Pago".
  PAGO
  AGUARDANDO_IMPRESSAO
  SEPARANDO
  PENDENTE
  CONFERINDO
  EMBALANDO
  EMBALADO
  PROCESSANDO
  PROCESSADO
  ENVIADO
  EM_ROTA
  ENTREGUE
  CONCLUIDO
  ESTORNO
  ESTORNO_PARCIAL
  CANCELADO
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String
  comandaNumber String?
  status        OrderStatus @default(EM_ANALISE)

  // "N° de Peças no Pedido": quantidade total de pecas vinculadas ao pedido,
  // informada no formulario de Vendas ao lado do Numero do Pedido. E um dado
  // DECLARADO (nao derivado de OrderItem/CampaignItem) — serve para conferencia
  // na separacao e para o Controle de Pecas. Default 0 para pedidos antigos.
  pieceCount    Int         @default(0)

  // ----- CONTROLE DE PECAS (tipo "10 - Peças p/ Blogueira") -----
  // Estado da peca emprestada. null = ainda nao entrou no controle (o pedido
  // ainda nao foi ENTREGUE). A transicao para EM_USO so acontece apos o
  // registro de entrega — regra aplicada em src/lib/actions/pieces.ts.
  pieceStatus   PieceStatus?

  store       Store     @relation(fields: [storeId], references: [id])
  storeId     String
  // "Loja de Origem" do pedido (conceito novo, separado de store).
  // Nullable: pedidos antigos nao tem. Define o fluxo (simplificado ou padrao).
  originStore   OriginStore? @relation(fields: [originStoreId], references: [id])
  originStoreId String?
  orderType   OrderType @relation(fields: [orderTypeId], references: [id])
  orderTypeId String
  operation   Operation @relation(fields: [operationId], references: [id])
  operationId String

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  seller   User   @relation("OrderSeller", fields: [sellerId], references: [id])
  sellerId String

  // Forma de pagamento e Banco: preenchidos pelo FINANCEIRO na Analise de
  // Pedidos (nao mais no formulario de Vendas). Por isso sao opcionais no
  // cadastro; a obrigatoriedade e aplicada na hora de APROVAR o pedido.
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId  String?
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id])
  shippingMethodId String

  // Banco da transação (selecionado pelo Financeiro).
  bank   Bank?   @relation(fields: [bankId], references: [id])
  bankId String?

  paymentStatus   PaymentStatusOption? @relation(fields: [paymentStatusId], references: [id])
  paymentStatusId String?

  // CNPJ vinculado ao pedido pelo Financeiro (obrigatorio antes de aprovar).
  cnpj   Cnpj?   @relation(fields: [cnpjId], references: [id])
  cnpjId String?

  // Codigo de rastreio informado na transicao para PROCESSADO (opcional).
  trackingCode String?

  // RETIRADA NA LOJA (fluxo simplificado). Marcado no modal de saida de
  // Embalando quando o cliente vem buscar: o pedido vai a Pronto sem motorista
  // e sem rastreio, nao aparece no quadro do Motorista e pula Em Rota — a loja
  // avanca de Pronto direto para Entregue. Default false para todo o legado.
  pickupAtStore Boolean @default(false)

  // Token do LINK DE ACOMPANHAMENTO enviado ao cliente final
  // (/acompanhar/<trackingToken>). E opaco e independente do `id` de propósito:
  // o id circula em rotas internas (ex.: /etiqueta/<id>), e vazar o link do
  // cliente nao pode virar um palpite de URL administrativa.
  // Nullable porque pedidos anteriores a este recurso nao tinham o campo; a
  // migration faz o backfill e a action gera sob demanda no que faltar.
  trackingToken String? @unique

  // Vinculo opcional a uma campanha (meta por volume de itens).
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?
  // Quantidade de itens que este pedido contribui para a campanha.
  itemCount  Int       @default(0)
  // "Possui desconto?" — marcado no formulario de Vendas quando as pecas de
  // campanha deste pedido sao vendidas com desconto. Muda a premiacao por item:
  //   Atacado: R$4,00 (sem) / R$2,00 (com) · Varejo: R$5,00 (sem) / R$2,50 (com).
  // Pedidos antigos ficam false (sem desconto = valor integral).
  campaignDiscount Boolean @default(false)

  orderValue Decimal @default(0) @db.Decimal(10, 2)
  freight    Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal @default(0) @db.Decimal(10, 2)

  // Comprovante enviado pela Vendedora na criacao do pedido.
  // MANTIDO por compatibilidade: pedidos antigos usam este campo unico.
  // Pedidos novos gravam ate 5 comprovantes na tabela OrderPaymentProof.
  paymentProofPath String?
  // Segundo comprovante, anexado pelo FINANCEIRO na Analise de Pedidos.
  // Obrigatorio para aprovar. Visivel a todos ao expandir o card no fluxo.
  paymentProof2Path String?
  invoicePath      String?

  // "Observacoes de Envio" na UI. Vai para a logistica/motorista.
  notes String?

  // Endereço de entrega — preenchido apenas quando a forma de envio exige
  // (ShippingMethod.requiresAddress = true, ex.: "Excursão"). Todos opcionais
  // no banco (pedidos de outras formas de envio não têm endereço); a
  // obrigatoriedade é validada no formulário quando a forma exige.
  shipCep         String?
  shipStreet      String?  // Logradouro
  shipNumber      String?  // Número
  shipDistrict    String?  // Bairro
  shipCity        String?  // Cidade
  shipState       String?  // UF
  // Excursao selecionada (opcional). So faz sentido quando a forma de envio e
  // a de Excursao; o endereco da excursao pre-preenche os campos ship* acima.
  excursao   Excursao? @relation(fields: [excursaoId], references: [id])
  excursaoId String?
  // "Observacoes de Pagamento": exclusivo do FINANCEIRO na aprovacao.
  // NAO e exibido para motorista/logistica.
  paymentNotes String?

  // Comentario do FINANCEIRO no card da coluna "Pagamento pendente".
  // Campo proprio (e NAO o paymentNotes acima) porque tem outro dono e outro
  // momento: e escrito/reescrito enquanto o recebimento nao e confirmado.
  // Editavel a qualquer momento; null = sem comentario.
  paymentPendingNote String?

  // Pendencia sinalizada pelo FINANCEIRO ("Qual o problema?").
  // - financeIssue: texto da inconsistencia (null = sem pendencia ativa).
  // - financeIssueAt: quando foi sinalizada.
  // - financeIssueResolvedAt: quando VENDAS marcou como resolvida
  //   (se preenchido com issue ainda presente, ficou resolvida; usamos os
  //    dois para saber se a pendencia esta ATIVA ou ja RESOLVIDA).
  financeIssue           String?
  financeIssueAt         DateTime?
  financeIssueResolvedAt DateTime?

  // Carimbo da APROVACAO do Financeiro (auditOrder -> AGUARDANDO_IMPRESSAO, ou
  // markOrderPaid -> PAGO no fluxo simplificado). Existe para o acompanhamento
  // do minimo de compras do Select: so o pedido aprovado conta, e conta no
  // ciclo em que a aprovacao aconteceu, nao no da criacao.
  // Null = nunca aprovado (em analise, estornado, cancelado).
  financeApprovedAt DateTime?

  items         OrderItem[]
  campaignItems CampaignItem[]
  paymentProofs OrderPaymentProof[]
  financeProofs OrderFinanceProof[]
  delivery      Delivery?
  driverPayment DriverPayment?
  history       OrderStatusHistory[]
  pieceMovements PieceMovement[]
  delayReasons  OrderDelayReason[]
  returns       OrderReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([pieceStatus])
  @@index([sellerId])
  @@index([customerId])
  @@index([createdAt])
  @@index([campaignId])
  @@index([cnpjId])
  @@index([excursaoId])
  @@index([financeApprovedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

// Comprovantes de pagamento enviados pela Vendedora no Novo Pedido.
// Um pedido aceita ate 5 (o limite e aplicado na action, nao no banco).
// Segue a regra do projeto: aqui vai apenas o CAMINHO do arquivo (.webp no
// disco), nunca o binario.
model OrderPaymentProof {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  filePath  String
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Comprovantes anexados pelo FINANCEIRO na Analise de Pedidos (ate 5).
// O PRIMEIRO tambem e espelhado em Order.paymentProof2Path, que continua
// sendo a trava de aprovacao (nao quebrar essa regra).
model OrderFinanceProof {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  filePath  String
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  changedBy String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ===========================================================================
// CONTROLE DE PECAS (Logistica > "Controle de Peças")
// Aplica-se apenas aos pedidos do tipo "10 - Peças p/ Blogueira".
// ===========================================================================

// Estados do Controle de Pecas.
//
// ORDEM DAS COLUNAS NO QUADRO (definida em src/lib/piece-control.ts):
//   Em Uso -> Reprocessamento -> Devolvido -> Finalizado
//
// EM_MANUTENCAO continua sendo o valor gravado no banco; o rotulo exibido
// passou a ser "Reprocessamento". Mesma decisao ja tomada em ENVIADO -> "Pronto":
// renomear o valor do enum exigiria reescrever historico e integracoes sem
// nenhum ganho funcional.
//
// FINALIZADO e o estado TERMINAL: so ao chegar nele o fluxo do pedido e
// considerado encerrado.
enum PieceStatus {
  EM_USO
  DEVOLVIDO
  EM_MANUTENCAO
  FINALIZADO
}

// Trilha de auditoria das movimentacoes do quadro de Controle de Pecas.
// Guarda de/para, observacao e quem moveu. Nunca sobrescrevemos: o estado
// atual vive em Order.pieceStatus e o historico completo vive aqui.
model PieceMovement {
  id        String       @id @default(cuid())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  // null quando e a PRIMEIRA entrada no controle (entrega registrada).
  fromStatus PieceStatus?
  toStatus   PieceStatus
  note       String?
  changedBy  String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ===========================================================================
// ENTREGA / MOTORISTAS
// ===========================================================================

enum DeliveryStatus {
  AGUARDANDO
  ATRIBUIDA
  EM_ROTA
  ENTREGUE
  FALHOU
}

model Delivery {
  id     String         @id @default(cuid())
  status DeliveryStatus @default(AGUARDANDO)

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  driver   User?   @relation("DeliveryDriver", fields: [driverId], references: [id])
  driverId String?

  assignedAt  DateTime?
  startedAt   DateTime?
  deliveredAt DateTime?
  failReason  String?

  // Valor do servico de entrega, informado pelo PROPRIO MOTORISTA ao concluir
  // (obrigatorio na tela de conclusao). E o valor que o Financeiro ve em
  // "Pagamentos de Motoristas" e que pre-preenche o pagamento — o valor pago
  // fica em DriverPayment.amount e pode diferir. Null nas entregas concluidas
  // antes de o campo existir.
  driverFee   Decimal?  @db.Decimal(10, 2)

  proofs Proof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([driverId])
}

model Proof {
  id         String   @id @default(cuid())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String
  filePath   String
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  @@index([deliveryId])
}

// Pagamento da ENTREGA ao motorista (Financeiro > "Pagamentos de Motoristas").
// Registrado quando o Financeiro confirma o pagamento de um pedido ENTREGUE.
// Um pagamento por pedido (1-1). Guarda o valor pago, a chave PIX usada (copia
// no momento do pagamento, para nao mudar se o cadastro do motorista mudar
// depois) e quem confirmou. NUNCA movimenta dinheiro: e apenas o registro.
model DriverPayment {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique

  driver   User   @relation("DriverPaymentDriver", fields: [driverId], references: [id])
  driverId String

  // Valor da entrega pago ao motorista.
  amount   Decimal @db.Decimal(10, 2)
  // Chave PIX usada no pagamento (snapshot; pode diferir do cadastro atual).
  pixKey   String?
  // Usuario (Financeiro/Gestao) que confirmou o pagamento.
  confirmedById String?
  createdAt DateTime @default(now())

  @@index([driverId])
}

// ===========================================================================
// CHAMADOS DE MOTORISTAS (vindos do Build.Connect)
// ===========================================================================

// Chamado de transporte aberto no Build.Connect e gerido aqui. NAO e pedido:
// nao passa por Order/Delivery nem pelo pagamento de motoristas. O Connect
// e quem abre e acompanha; o Flow e o dono do registro a partir da chegada.
enum TransportStatus {
  ABERTO
  ATRIBUIDO
  EM_ROTA
  CONCLUIDO
  CANCELADO
}

model TransportRequest {
  id        String          @id @default(cuid())
  // Id do Ticket no Connect. Unico: reenviar o mesmo chamado nao duplica.
  connectId String          @unique
  // Codigo que a operacao fala em voz alta ("o MOT-014 ja foi?"). Vem do Connect.
  code      String
  status    TransportStatus @default(ABERTO)

  // Solicitante e SNAPSHOT do Connect — nao existe como usuario do Flow.
  requesterConnectId String
  requesterName      String
  requesterSector    String?
  contact            String?

  serviceType String
  description String

  // Origem: unidade (rotulo) OU endereco manual. Destino: endereco.
  originUnit     String?
  originStreet   String?
  originNumber   String?
  originDistrict String?
  destStreet     String
  destNumber     String?
  destDistrict   String?

  // Coordenadas geocodificadas UMA vez em "Iniciar rota" (nulas se falhar:
  // o mapa do Connect degrada para "so GPS ao vivo").
  originLat Float?
  originLng Float?
  destLat   Float?
  destLng   Float?

  driver   User?   @relation("TransportDriver", fields: [driverId], references: [id])
  driverId String?
  // Quem atribuiu (Logistica/Gestao) — null quando o proprio motorista assumiu.
  assignedById String?

  assignedAt   DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  distanceKm   Float?
  // Comprovante (.webp). So o caminho, como todo arquivo do sistema.
  proofPath    String?
  cancelReason String?

  images    TransportImage[]
  positions TransportPosition[]
  history   TransportHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([driverId])
  @@index([createdAt])
}

// Fotos anexadas na abertura (copia das do Connect).
model TransportImage {
  id        String           @id @default(cuid())
  request   TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  filePath  String
  order     Int              @default(0)

  @@index([requestId, order])
}

// Rastro GPS da corrida.
model TransportPosition {
  id         String           @id @default(cuid())
  request    TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  lat        Float
  lng        Float
  heading    Float?
  speed      Float?
  recordedAt DateTime         @default(now())

  @@index([requestId, recordedAt])
}

// Linha do tempo mostrada nos dois sistemas.
model TransportHistory {
  id        String           @id @default(cuid())
  request   TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  // "criado" | "atribuido" | "assumido" | "desatribuido" | "em_rota" | "concluido" | "cancelado"
  event     String
  // Nome de quem fez (motorista/gestao) ou "Build.Connect".
  actorName String?
  note      String?
  createdAt DateTime         @default(now())

  @@index([requestId, createdAt])
}

// ===========================================================================
// NOTIFICACOES
// ===========================================================================

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  message   String
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ===========================================================================
// METAS E CAMPANHAS (Rank de Vendas)
// ===========================================================================

// Meta financeira individual (por usuario, mes/ano, escopo).
// IMPORTANTE: a unicidade NAO usa @@unique aqui porque o Prisma nao suporta
// indice unico PARCIAL (com WHERE). A regra correta vive na migration SQL:
//   - Meta GERAL    (campaignId NULL):     unica por (user, mes, ano, escopo)
//   - Meta CAMPANHA (campaignId NOT NULL): unica por (user, mes, ano, escopo, campanha)
// Assim a Geral e as varias metas de Campanha convivem sem se sobrescrever.
model SalesGoal {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  amount    Decimal    @db.Decimal(12, 2) // meta em R$ (usada quando Geral)
  // Meta por quantidade de itens. Usada quando a meta é vinculada a Campanha.
  targetItems Int?
  month     Int        // 1-12
  year      Int
  scope     SalesModel // ATACADO ou VAREJO
  // null = meta Geral; preenchido = meta vinculada a uma Campanha.
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?
  createdAt DateTime   @default(now())

  @@index([userId, month, year])
  @@index([month, year])
  @@index([campaignId])
}

// AJUSTE MANUAL DO REALIZADO NO RANKING DE VENDAS.
//
// Existe para o caso em que a venda aconteceu mas o pedido NAO foi registrado
// na plataforma: sem isso o ranking mostraria um numero menor que o real e a
// vendedora apareceria abaixo da posicao dela.
//
// `amount` e o valor DIGITADO manualmente e SUBSTITUI o consolidado do periodo
// para aquele vendedor. `systemAmount` guarda quanto o sistema havia calculado
// no instante do ajuste — assim a tela consegue avisar quando novos pedidos
// entraram depois e o ajuste ficou defasado.
//
// Um registro por vendedor/mes/ano: o ajuste vale para os tres paineis (Geral,
// Varejo e Atacado), que sao recortes do MESMO numero.
model RankAdjustment {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  month  Int    // 1-12
  year   Int
  // Valor manual do realizado, em R$.
  amount       Decimal @db.Decimal(12, 2)
  // Consolidado pelo sistema no momento em que o ajuste foi salvo.
  systemAmount Decimal @db.Decimal(12, 2) @default(0)
  // CORTE do ajuste: instante ate o qual `amount` responde pelo realizado.
  // Pedidos criados a partir daqui NAO sao substituidos pelo ajuste — eles
  // SOMAM sobre ele. Null = ajuste anterior a esta regra; nesse caso o corte
  // usado e a constante AJUSTE_CORTE_PADRAO (ver src/lib/rank-data.ts).
  baselineAt   DateTime?
  note      String?
  changedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([month, year])
}

// Campanha: apenas o nome (cadastro simples). As metas vinculadas
// a ela ficam em SalesGoal (campo campaignId).
model Campaign {
  id         String   @id @default(cuid())
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  // CAMPANHA DE SELECT: preenchido = esta campanha acompanha a venda do
  // servico Select de UMA marca, e as vendas entram nela pela marca escolhida
  // na adesao. Nulo = campanha comum, de pecas.
  //
  // UNIQUE: duas campanhas de Select da mesma marca dividiriam a atribuicao
  // sem criterio — a venda cairia na primeira que a consulta devolvesse. O
  // Postgres permite varios NULL, entao campanha comum nao e limitada.
  //
  // Substitui o reconhecimento por NOME (o `shortcut:` de rank-data.ts):
  // renomear a campanha deixava de atribuir as vendas, em silencio.
  selectBrand WholesaleBrand? @unique

  orders Order[]
  goals  SalesGoal[]
  items  CampaignItem[]
}

// Item de campanha lançado dentro de um pedido. Permite MÚLTIPLAS referências
// de campanha por pedido, cada uma com sua quantidade e valor próprios.
// Substitui a semântica antiga do par (Order.campaignId + Order.itemCount),
// que só comportava UMA campanha por pedido. Os campos legados no Order são
// mantidos por compatibilidade e alimentados com os agregados destes itens.
model CampaignItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  // "Referência" da peça de campanha (texto livre informado no pedido).
  reference String
  quantity  Int      @default(0)
  // Valor (R$) registrado individualmente para este item de campanha.
  // É esta soma que alimenta a coluna "Valor" no Rank > Performance na Campanha.
  value     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([campaignId])
}

// ===========================================================================
// TAREFAS DIARIAS (Kanban da vendedora)
// ===========================================================================

// Status do quadro de tarefas: A Fazer -> Fazendo -> Concluida.
enum TaskStatus {
  A_FAZER
  FAZENDO
  CONCLUIDA
}

// Tarefa diaria de uma vendedora. Kanban pessoal (cada uma ve as proprias;
// a Gestao ve todas). "category" e texto livre digitado pela vendedora.
model DailyTask {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  // Horarios do dia em texto "HH:MM" (simples; a tarefa e do dia corrente).
  startTime String?
  endTime   String?
  category  String?
  notes     String?
  status    TaskStatus @default(A_FAZER)
  // Ordem manual dentro da coluna (para reordenacao futura; menor = topo).
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

// ===========================================================================
// TEMPO REAL (polling) — eventos de pedido persistidos
// ===========================================================================

// Fila curta de eventos para o polling do dashboard. As Server Actions inserem
// uma linha a cada criacao/mudanca de pedido; o endpoint /api/events/poll le os
// eventos posteriores ao ultimo timestamp que o cliente ja viu.
//
// Por que no banco e nao em memoria: no container standalone do Next, a Server
// Action e o route handler do poll nao compartilham o mesmo estado de modulo,
// entao um buffer em memoria nunca "casa". O Postgres e o canal compartilhado.
//
// Limpeza: linhas antigas sao descartaveis (o cliente so olha os ultimos
// segundos). Um DELETE periodico evita crescimento — ver realtime/bus.ts.
model RealtimeEvent {
  id            String   @id @default(cuid())
  type          String
  orderId       String
  orderNumber   String?
  customerName  String?
  status        String?
  originStoreId String?
  notifyRoles   String[] @default([])
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ===========================================================================
// MOTIVO DE ATRASO DE ETAPA (Fluxo / Logística)
// ===========================================================================
//
// Quando um card passa de 5 minutos ALÉM do prazo da etapa (Gestão > Etapas),
// o quadro pede ao setor dono daquele status que justifique o atraso. O motivo
// fica vinculado ao par (pedido, status) porque um mesmo pedido pode atrasar em
// várias etapas e cada atraso tem a sua própria causa — um campo único no Order
// perderia a justificativa anterior a cada novo atraso.
//
// `minutesLate` é o atraso NO MOMENTO da justificativa (snapshot). Guardar o
// número evita ter que recalcular a régua de prazos históricos depois: o limite
// da etapa pode mudar em Gestão > Etapas, e o que foi justificado não muda.
model OrderDelayReason {
  id      String      @id @default(cuid())
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  status  OrderStatus

  reason      String
  minutesLate Int

  // Usuário que justificou (ID; o nome é resolvido na leitura, como no
  // OrderStatusHistory).
  createdById String?
  createdAt   DateTime @default(now())

  // Um motivo por etapa: a segunda justificativa da mesma etapa ATUALIZA a
  // primeira em vez de empilhar registros.
  @@unique([orderId, status])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// DEVOLUCOES (Vendas > Devolucoes / Historico de Vendas > Devolucoes)
// ---------------------------------------------------------------------------
// Uma devolucao e uma lista de pecas (referencia, quantidade, valor) registrada
// pela vendedora (ou Gestao/Financeiro) sobre um pedido. Ao gravar, a soma dos
// valores e ABATIDA de Order.orderValue (e total recalculado); o pedido
// continua no fluxo com o status que tinha. O valor bruto original nao se
// perde: orderValue passa a ser o liquido e a soma das devolucoes reconstroi o
// bruto. Varias devolucoes por pedido sao permitidas — cada uma e um registro.
//
// A referencia e texto livre: o pedido nao tem itens cadastrados, so os itens
// de campanha tem referencia. Quando a referencia digitada casa com a de um
// CampaignItem do pedido, a quantidade e o valor daquele item tambem caem
// (ver src/lib/order-returns.ts).
model OrderReturn {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  // Quem registrou. Sem FK: usuario apagado nao pode levar a devolucao junto.
  registeredById String?
  // Observacao livre (motivo, estado da peca...). Opcional.
  note String?
  // Soma dos valores dos itens, gravada para leitura rapida do historico.
  totalValue Decimal @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  items OrderReturnItem[]

  @@index([orderId])
}

model OrderReturnItem {
  id       String      @id @default(cuid())
  return   OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId String

  reference String
  quantity  Int
  value     Decimal @db.Decimal(10, 2)

  @@index([returnId])
}

// ===========================================================================
// SELECT — venda de SERVICO (adesao de uma cliente a um plano)
// ===========================================================================
//
// O Select nao e um pedido. E contrato proprio: tem validade, mensalidade e um
// minimo de compras mensal esperado da cliente. Nao depende do modulo de
// pedidos para existir — so o consulta para acompanhar o minimo de compras.
//
// TRES ESTADOS SAO DERIVADOS, NUNCA GRAVADOS:
//   - parcela VENCIDA  = PENDENTE e dueDate < hoje
//   - parcela PARCIAL  = 0 < paidAmount < amount
//   - contrato ENCERRADO por data = hoje >= fim efetivo
// Derivar em vez de gravar tira a verdade dos dados da dependencia de um
// agendador. O agendador (/api/cron/selects) so NOTIFICA; se ele parar de
// rodar, nenhuma tela mente — apenas o aviso deixa de chegar.

enum SelectContractStatus {
  ATIVO
  CANCELADO
  ENCERRADO
}

enum SelectInstallmentStatus {
  PENDENTE
  PAGA
  CANCELADA
}

// Plano de servico (Estrela, Rubi, Diamante, Diamante Wincon).
// Os valores daqui sao COPIADOS para o contrato na adesao: reajustar um plano
// nao pode alterar Selects ja vendidos.
model SelectPlan {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)

  validityMonths Int @default(12)
  // Mensalidade BASE do plano, SEM o Build.Sales. A mensalidade que a cliente
  // paga e esta mais BUILD_SALES_MONTHLY (lib/select-contract.ts), somado pelo
  // servidor na adesao. Quem ler esta coluna direto ve 597, nao 664.
  //
  // Nulos quando editableValues = true (plano negociado): nao ha valor de
  // tabela, cada adesao combina o seu — e o Build.Sales entra sobre ele igual.
  monthlyAmount      Decimal? @db.Decimal(10, 2)
  minMonthlyPurchase Decimal? @db.Decimal(10, 2)
  // true: validade, mensalidade e minimo sao digitados na adesao.
  editableValues     Boolean  @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  benefits  SelectPlanBenefit[]
  contracts SelectContract[]

  @@index([active, sortOrder])
}

model SelectPlanBenefit {
  id     String     @id @default(cuid())
  plan   SelectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId String

  sortOrder Int    @default(0)
  text      String
  // Entra na regua do roadmap (beneficio EXECUTAVEL: tem marco de entrega) ou
  // fica fora dela (casual/continuo, tipo "suporte sob demanda", que nao tem
  // conclusao e por isso nao pode contar percentual). Default true: o
  // beneficio comum e entregavel, e quem cadastra desmarca a excecao.
  executable Boolean @default(true)

  @@index([planId, sortOrder])
}

// A adesao propriamente dita.
model SelectContract {
  id String @id @default(cuid())

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  plan       SelectPlan @relation(fields: [planId], references: [id])
  planId     String
  // Responsavel pela venda. FK real (e coluna de filtro da tela do Financeiro),
  // ao contrario dos campos de auditoria abaixo.
  responsible   User   @relation("SelectResponsible", fields: [responsibleId], references: [id])
  responsibleId String

  // Datas puras (sem hora): o contrato e por dia, e hora nenhuma faria o
  // "comeca no fim do anterior" bater.
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  // Encerramento antecipado por TROCA. Fim efetivo = closedAt ?? endDate.
  closedAt  DateTime? @db.Date

  // Vinculo 1:1 da troca: este contrato foi substituido por aquele.
  replacedBy   SelectContract?  @relation("SelectReplacement", fields: [replacedById], references: [id])
  replacedById String?          @unique
  replaces     SelectContract?  @relation("SelectReplacement")

  // ----- SNAPSHOT: copia dos valores no momento da adesao -----
  validityMonths     Int
  monthlyAmount      Decimal @db.Decimal(10, 2)
  // mensalidade x validade. E o VALOR DO CONTRATO, que com inicio retroativo
  // NAO e a soma das parcelas geradas (ver SelectInstallment).
  totalAmount        Decimal @db.Decimal(10, 2)
  minMonthlyPurchase Decimal @db.Decimal(10, 2)
  // Nome do plano no momento da adesao: renomear o plano nao reescreve o
  // historico de quem ja comprou.
  planNameSnapshot   String

  // Marca da contratacao, escolhida na adesao. E ela que leva a venda para a
  // campanha de Select correspondente (Campaign.selectBrand).
  //
  // Opcional no banco por causa dos contratos criados antes deste campo; o
  // formulario de adesao exige. Contrato sem marca nao entra em campanha
  // nenhuma, e continua somando normalmente no ranking e nas metas.
  brand WholesaleBrand?

  status       SelectContractStatus @default(ATIVO)
  canceledAt   DateTime?
  canceledById String?
  cancelReason String?

  // Auditoria. Os *ById NAO tem FK, pelo mesmo motivo de OrderReturn: apagar
  // um usuario nao pode apagar (nem travar) o registro de um contrato.
  createdAt   DateTime @default(now())
  createdById String
  // So se move em cancelamento e encerramento: contrato nao se sobrescreve.
  updatedAt   DateTime @updatedAt
  updatedById String?

  installments SelectInstallment[]
  steps        SelectContractStep[]

  @@index([customerId])
  @@index([status])
  @@index([startDate])
  @@index([responsibleId])
}

// ETAPA DO ROADMAP de UM contrato: as etapas previas (apresentacao e
// negociacao) e depois uma por beneficio executavel do plano. Geradas na
// adesao, dentro da mesma transacao do contrato.
//
// `label` e SNAPSHOT, pelo mesmo motivo de `planNameSnapshot`: `updateSelectPlan`
// apaga e recria TODOS os SelectPlanBenefit a cada salvamento do plano, entao
// id de beneficio nao sobrevive a uma edicao. Apontar para ele deixaria o
// roadmap de todo cliente orfao na primeira correcao de virgula no plano.
//
// Sem coluna de percentual: progresso e concluidas/total, contado na leitura.
// Gravado seria um numero a mais para dessincronizar.
model SelectContractStep {
  id         String         @id @default(cuid())
  contract   SelectContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  sortOrder Int
  label     String

  // Concluida quando tem data. Os *ById sem FK, como no resto do Select:
  // apagar um usuario nao pode apagar nem travar o registro da entrega.
  doneAt   DateTime?
  doneById String?

  createdAt DateTime @default(now())

  events SelectContractStepEvent[]

  @@unique([contractId, sortOrder])
  @@index([contractId, sortOrder])
}

// HISTORICO DE INTERACAO DA ETAPA — quem marcou, quem desmarcou, e quando.
//
// Existe porque `SelectContractStep.doneAt/doneById` guardam o ESTADO ATUAL:
// desmarcar os zera e apaga quem tinha marcado. "Historico nao se reescreve"
// (principio 2) exige um registro proprio, so de insercao — nada aqui e
// atualizado ou apagado depois de gravado.
model SelectContractStepEvent {
  id     String             @id @default(cuid())
  step   SelectContractStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId String

  // O que o clique fez: true marcou como concluida, false desfez.
  done Boolean

  // Autor SEM FK, como o resto da auditoria do Select. `actorName` e COPIA do
  // nome no momento do clique, pelo mesmo motivo de `planNameSnapshot`: o
  // historico tem de continuar legivel depois que o usuario sai da empresa, e
  // sem join nenhum para renderizar.
  actorId   String
  actorName String

  createdAt DateTime @default(now())

  @@index([stepId, createdAt])
}

// Parcela mensal. Geradas na adesao, uma por mes de validade — EXCETO as de
// vencimento ja passado, que nao sao geradas (contrato retroativo nao nasce
// cobrando o passado). Por isso `number` preserva a numeracao do contrato:
// um Select de 12 meses iniciado ha 9 gera as parcelas 10, 11 e 12 de 12.
model SelectInstallment {
  id         String         @id @default(cuid())
  contract   SelectContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  number  Int
  dueDate DateTime @db.Date
  amount  Decimal  @db.Decimal(10, 2)
  // Soma dos pagamentos NAO revertidos. Denormalizado e reescrito dentro da
  // mesma transacao de todo pagamento/reversao: os indicadores do painel somam
  // esta coluna em vez de varrer SelectPayment a cada leitura.
  paidAmount Decimal @db.Decimal(10, 2) @default(0)

  status    SelectInstallmentStatus @default(PENDENTE)
  // Quando paidAmount alcancou amount.
  settledAt DateTime?
  note      String?

  createdAt   DateTime @default(now())
  createdById String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  payments SelectPayment[]

  @@unique([contractId, number])
  @@index([status, dueDate])
  @@index([dueDate])
}

// Um pagamento de uma parcela. Varios por parcela: pagamento parcial e a
// regra, nao a excecao. Reverter NAO apaga a linha — marca reversedAt, para a
// auditoria enxergar o engano e a correcao.
model SelectPayment {
  id            String            @id @default(cuid())
  installment   SelectInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  installmentId String

  paidAt DateTime @db.Date
  amount Decimal  @db.Decimal(10, 2)

  // Os mesmos cadastros que o Financeiro ja administra em Ferramentas.
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String?
  bank            Bank?          @relation(fields: [bankId], references: [id])
  bankId          String?
  cnpj            Cnpj?          @relation(fields: [cnpjId], references: [id])
  cnpjId          String?

  proofPath String?
  note      String?

  // UM pagamento real da cliente pode cobrir mais de uma parcela: quem paga
  // R$ 700 numa mensalidade de R$ 500 adianta R$ 200 da seguinte. Isso vira
  // duas linhas (uma por parcela), e o batchId as liga de volta ao lancamento
  // unico que as originou. Sem ele, a auditoria leria dois pagamentos que
  // nunca aconteceram separados — e reverter um deixaria o outro orfao.
  // Null nos pagamentos que couberam numa parcela so.
  batchId String?

  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  createdAt   DateTime @default(now())
  createdById String

  @@index([installmentId])
  @@index([paidAt])
  @@index([batchId])
}

// ===========================================================================
// ATACADO — captação de revendedor (LP pública + Análise de Clientes)
// ===========================================================================

enum WholesaleBrand {
  OKEY
  LOV_CLUB
}

// Quatro status, da aba "Modal com as respostas" da planilha. NÃO existe
// "solicitar ajustes" (decisão 6): a especificação escrita citava esse estado,
// a planilha não — e é a planilha que manda no conteúdo.
enum WholesaleLeadStatus {
  EM_ANALISE
  APROVADO
  REPROVADO
  // Sinal de risco/fraude, com justificativa obrigatória (decisão 8).
  CUIDADO
}

enum WholesaleServiceModel {
  LOJA_FISICA
  LOJA_ONLINE
  FISICA_E_ONLINE
  OUTRO
}

enum WholesaleFoundUs {
  INSTAGRAM
  SITE
  INDICACAO
  OUTRO
}

enum WholesaleInvestmentBand {
  ATE_3K
  DE_3_A_5K
  DE_5_A_10K
  ACIMA_10K
}

// Qual imagem foi PEDIDA no segundo upload (decisão 21). Loja só online não
// tem espaço físico para fotografar; o campo segue obrigatório, muda o que se
// pede. Guardar qual foi pedida é o que permite a análise saber o que olha.
enum WholesaleStoreImageKind {
  ESPACO_FISICO
  LOJA_ONLINE
}

/// Uma candidatura a revendedor, vinda da LP pública.
/// NÃO é uma Customer (decisão 4): aprovar aqui não cria cliente (decisão 5).
model WholesaleLead {
  id     String              @id @default(cuid())
  brand  WholesaleBrand
  status WholesaleLeadStatus @default(EM_ANALISE)

  // Dono do lead. NULO = chegou sem código de indicação válido e espera a
  // Gestão distribuir (decisão 14). Não descartamos o cadastro: perder uma
  // lojista real porque o parâmetro se perdeu é pior que uma fila de triagem.
  sellerId String?
  seller   User?   @relation("WholesaleLeadSeller", fields: [sellerId], references: [id])

  // --- Seção 1: Boas-vindas e Identificação ---
  contactName String
  email       String
  /// Só dígitos, com DDD e sem código de país — como User.phone. É a chave do
  /// aviso de repetição (decisão 9); formatação divergente faria o mesmo
  /// número não casar consigo mesmo.
  phone       String
  story       String

  // --- Seção 2: Sobre o Seu Negócio ---
  /// UF de 2 letras (decisão 23).
  state             String
  city              String
  /// NULO só em candidatura IMPORTADA de planilha antiga (ver
  /// src/lib/wholesale-import.ts): o formulário público sempre grava um valor,
  /// e a planilha que a Gestão tinha não registrava estas respostas. Preencher
  /// com "OUTRO" faria a ficha afirmar à analista algo que ninguém respondeu.
  serviceModel      WholesaleServiceModel?
  serviceModelOther String?
  /// Handle sem o "@".
  instagram         String
  instagramImagePath String
  storeImagePath     String
  /// Derivado de serviceModel (storeImageKindFor); NULO quando ele é nulo.
  storeImageKind     WholesaleStoreImageKind?
  marketTime         String
  teamSize           String

  // --- Seção 3: Conectividade e Parceria Comercial ---
  brandsCarried  String
  /// NULO só em candidatura importada — ver serviceModel acima.
  foundUs        WholesaleFoundUs?
  foundUsOther   String?
  followTime     String
  /// NULO só em candidatura importada — ver serviceModel acima.
  investmentBand WholesaleInvestmentBand?
  /// NULO só em candidatura importada: `false` leria como "não quer visita".
  wantsVisit     Boolean?

  // --- Seção 4: Validação Cadastro ---
  /// Só dígitos (14). SEM @unique: a repetição é informação, não erro — é ela
  /// que alimenta o aviso da decisão 9.
  cnpj String

  // --- Decisão ---
  /// "Atendente" da planilha: quem aprovou/reprovou.
  decidedById String?
  decidedBy   User?     @relation("WholesaleLeadDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  /// Um dos 34 de wholesale-rejection-codes.ts. Obrigatório em REPROVADO.
  rejectionCode String?
  /// Obrigatório em CUIDADO (decisão 8).
  cautionReason String?
  /// Texto livre, exibido em maiúsculas (decisão 19).
  assistantName String?

  /// IP do envio: rate limit e o código 34 (tentativa de burlar cadastro).
  submittedIp String?

  /// CHAVE DA PLANILHA. Nula = chegou pelo formulário público; preenchida =
  /// veio da importação (src/lib/wholesale-import.ts). Serve a duas coisas:
  /// marca a origem, e é por ela que reimportar o arquivo ATUALIZA a linha em
  /// vez de criar outra. `@unique` com nulo permitido — o Postgres aceita
  /// vários NULL num índice único, então as candidaturas do formulário não
  /// disputam nada entre si (mesmo arranjo de `Campaign.selectBrand`).
  importKey String? @unique

  /// Posicao no rodizio do link geral. NULL = veio pelo link de uma vendedora
  /// (dona fixa). Numero = veio pelo link geral e passa para a seguinte a cada
  /// dia sem avaliacao. Ver src/lib/wholesale-rodizio.ts.
  rodizioIndice Int?

  events WholesaleLeadEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, status])
  @@index([sellerId, status])
  @@index([cnpj])
  @@index([phone])
  @@index([rodizioIndice])
}

/// Diário de mudanças de status (decisão 12). Sem ele os campos de decisão
/// seriam sobrescritos e a Gestão só poderia analisar o veredito final — não
/// reversões, não acerto do CUIDADO, não tempo até a decisão.
/// Precedente no projeto: OrderStatusHistory.
model WholesaleLeadEvent {
  id     String        @id @default(cuid())
  leadId String
  lead   WholesaleLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStatus    WholesaleLeadStatus
  toStatus      WholesaleLeadStatus
  rejectionCode String?
  note          String?

  actorId String
  actor   User   @relation("WholesaleLeadEventActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// Tentativas contadas pelo rate limit, compartilhadas entre instancias.
///
/// Uma linha por tentativa (janela deslizante). O expurgo das linhas fora de
/// qualquer janela acontece na propria checagem e em /api/cron/leads — ver
/// src/lib/rate-limit.ts.
model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@index([at])
}
