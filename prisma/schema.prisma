// Build.Flow - schema v2 (PostgreSQL)
// Regra de ouro: imagens/arquivos NUNCA viram blob. So o caminho (String).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// CONFIGURACAO DE PRAZOS POR ETAPA (Gestao > Etapas)
// ===========================================================================

// Tempo limite (em minutos) que um pedido deve permanecer em cada status do
// Fluxo de Pedidos. Usado para colorir os cards: >=50% do limite = amarelo
// (aviso), > limite = vermelho (alerta). Um registro por status (unico).
model StageTimeLimit {
  id        String      @id @default(cuid())
  status    OrderStatus @unique
  // Limite em minutos. null/0 = sem alerta para este status.
  limitMinutes Int       @default(0)
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
}

// ===========================================================================
// USUARIOS / PERFIS
// ===========================================================================

enum Role {
  GESTAO
  VENDAS
  FINANCEIRO
  LOGISTICA
  MOTORISTA
}

// Modelo de venda do vendedor: trava o escopo de tudo que ele vende.
enum SalesModel {
  VAREJO
  ATACADO
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  // Obrigatorio para VENDAS; null para os demais perfis.
  salesModel SalesModel?
  // Chave PIX do MOTORISTA (para o pagamento de entregas pelo Financeiro).
  // Opcional; so faz sentido para o perfil MOTORISTA (validado na action).
  pixKey    String?
  // Telefone do MOTORISTA. Guardado SEMPRE como digitos com DDD e sem o
  // codigo do pais (ex.: "11988887777") — a formatacao com mascara e so de
  // exibicao. Normalizar na gravacao evita ter de limpar a base depois, quando
  // o numero for consumido por um envio automatico.
  // Opcional; so faz sentido para o perfil MOTORISTA (validado na action).
  phone     String?
  active    Boolean  @default(true)
  // Versão da sessão. O JWT carrega este número; qualquer incremento invalida
  // TODOS os tokens já emitidos (logout server-side real, expulsão de usuário
  // desativado, "sair de todos os dispositivos"). Sem isto, um JWT roubado
  // valeria pelos 7 dias inteiros mesmo após logout.
  tokenVersion Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersAsSeller Order[]        @relation("OrderSeller")
  deliveries     Delivery[]     @relation("DeliveryDriver")
  notifications  Notification[]
  salesGoals     SalesGoal[]
  rankAdjustments RankAdjustment[]
  dailyTasks     DailyTask[]
  // "Lojas de Origem" atreladas ao usuario (max 2, validado na action).
  // Usado por VENDAS para escopo de criacao e por quem opera o fluxo por loja.
  originStores   OriginStore[]  @relation("UserOriginStores")
  pushSubscriptions PushSubscription[]
  driverPayments   DriverPayment[] @relation("DriverPaymentDriver")

  @@index([role])
}

// Inscrição de Web Push (Push API) de um dispositivo/navegador do usuário.
// Guarda o endpoint do serviço de push do navegador + chaves de criptografia
// (p256dh/auth) necessárias para o web-push cifrar a mensagem. Uma por
// dispositivo; o mesmo usuário pode ter várias (celular, desktop, etc.).
// NÃO guardamos payload aqui — só o "endereço" para onde enviar o push.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===========================================================================
// CADASTROS DE APOIO (gerenciados pela Gestao)
// ===========================================================================

model Store {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

// "Loja de Origem": conceito NOVO e separado do Store acima.
// - Cadastravel pela Gestao (as 4 iniciais vem do seed).
// - simplifiedFlow=true => fluxo Pago -> Embalado -> Entregue, sem NF,
//   comprovante obrigatorio (Iguatemi, Sao Paulo, Lov Club).
// - Relacao N-N com User (max 2 por usuario, validado na action).
model OriginStore {
  id             String   @id @default(cuid())
  name           String
  simplifiedFlow Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  users  User[]  @relation("UserOriginStores")
  orders Order[]
}

model OrderType {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Operation {
  id        String   @id @default(cuid())
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model ShippingMethod {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  // Quando true, o formulário de Vendas exige o endereço de entrega completo
  // (CEP, logradouro, número, bairro, cidade, UF) e habilita a etiqueta
  // térmica. Usado pela forma de envio "Excursão". Default false = sem
  // endereço (comportamento das demais formas de envio).
  requiresAddress Boolean @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Bank {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orders Order[]
}

// CNPJ da empresa (cadastro do Financeiro). Vinculado ao pedido na analise.
model Cnpj {
  id        String   @id @default(cuid())
  // Razao social / apelido para exibir no select.
  name      String
  // Numero do CNPJ (somente digitos ou formatado). Unico.
  document  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([active])
}

model PaymentStatusOption {
  id          String             @id @default(cuid())
  name        String
  disposition PaymentDisposition
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  orders      Order[]
}

enum PaymentDisposition {
  APROVA
  INTERROMPE
}

// ===========================================================================
// CLIENTES
// ===========================================================================

model Customer {
  id        String   @id @default(cuid())
  // Codigo do cliente (unico, obrigatorio).
  code      String   @unique
  name      String
  // Dados de localizacao e contato (todos opcionais). Usados para
  // pre-preencher o Endereco de Entrega no Novo Pedido (forma Excursao).
  cep       String?
  street    String? // Logradouro
  district  String? // Bairro
  city      String?
  state     String? // UF (2 letras)
  contact   String? // Telefone / E-mail / Responsavel (texto livre)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
}

// "Excursao": ponto de entrega coletivo (padrao visual do cadastro de
// Clientes). Selecionavel no Novo Pedido quando a forma de envio e a de
// Excursao (ShippingMethod.requiresAddress = true). Ao escolher, o endereco
// da excursao pre-preenche os campos ship* do pedido (editaveis).
model Excursao {
  id          String   @id @default(cuid())
  name        String
  address     String
  // "Funciona ate as" (horario limite). Texto livre (ex.: "18:00").
  cutoffTime  String?
  // Dias de funcionamento (texto livre, ex.: "Seg a Sex").
  operatingDays String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([name])
}

// ===========================================================================
// PRODUTOS / ESTOQUE
// ===========================================================================

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([active])
}

// ===========================================================================
// PEDIDOS
// ===========================================================================

enum OrderStatus {
  EM_ANALISE
  // Fluxo simplificado (Loja de Origem): apos o Financeiro clicar "Pago".
  PAGO
  AGUARDANDO_IMPRESSAO
  SEPARANDO
  PENDENTE
  CONFERINDO
  EMBALANDO
  EMBALADO
  PROCESSANDO
  PROCESSADO
  ENVIADO
  EM_ROTA
  ENTREGUE
  CONCLUIDO
  ESTORNO
  ESTORNO_PARCIAL
  CANCELADO
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String
  comandaNumber String?
  status        OrderStatus @default(EM_ANALISE)

  // "N° de Peças no Pedido": quantidade total de pecas vinculadas ao pedido,
  // informada no formulario de Vendas ao lado do Numero do Pedido. E um dado
  // DECLARADO (nao derivado de OrderItem/CampaignItem) — serve para conferencia
  // na separacao e para o Controle de Pecas. Default 0 para pedidos antigos.
  pieceCount    Int         @default(0)

  // ----- CONTROLE DE PECAS (tipo "10 - Peças p/ Blogueira") -----
  // Estado da peca emprestada. null = ainda nao entrou no controle (o pedido
  // ainda nao foi ENTREGUE). A transicao para EM_USO so acontece apos o
  // registro de entrega — regra aplicada em src/lib/actions/pieces.ts.
  pieceStatus   PieceStatus?

  store       Store     @relation(fields: [storeId], references: [id])
  storeId     String
  // "Loja de Origem" do pedido (conceito novo, separado de store).
  // Nullable: pedidos antigos nao tem. Define o fluxo (simplificado ou padrao).
  originStore   OriginStore? @relation(fields: [originStoreId], references: [id])
  originStoreId String?
  orderType   OrderType @relation(fields: [orderTypeId], references: [id])
  orderTypeId String
  operation   Operation @relation(fields: [operationId], references: [id])
  operationId String

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  seller   User   @relation("OrderSeller", fields: [sellerId], references: [id])
  sellerId String

  // Forma de pagamento e Banco: preenchidos pelo FINANCEIRO na Analise de
  // Pedidos (nao mais no formulario de Vendas). Por isso sao opcionais no
  // cadastro; a obrigatoriedade e aplicada na hora de APROVAR o pedido.
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId  String?
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id])
  shippingMethodId String

  // Banco da transação (selecionado pelo Financeiro).
  bank   Bank?   @relation(fields: [bankId], references: [id])
  bankId String?

  paymentStatus   PaymentStatusOption? @relation(fields: [paymentStatusId], references: [id])
  paymentStatusId String?

  // CNPJ vinculado ao pedido pelo Financeiro (obrigatorio antes de aprovar).
  cnpj   Cnpj?   @relation(fields: [cnpjId], references: [id])
  cnpjId String?

  // Codigo de rastreio informado na transicao para PROCESSADO (opcional).
  trackingCode String?

  // Token do LINK DE ACOMPANHAMENTO enviado ao cliente final
  // (/acompanhar/<trackingToken>). E opaco e independente do `id` de propósito:
  // o id circula em rotas internas (ex.: /etiqueta/<id>), e vazar o link do
  // cliente nao pode virar um palpite de URL administrativa.
  // Nullable porque pedidos anteriores a este recurso nao tinham o campo; a
  // migration faz o backfill e a action gera sob demanda no que faltar.
  trackingToken String? @unique

  // Vinculo opcional a uma campanha (meta por volume de itens).
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?
  // Quantidade de itens que este pedido contribui para a campanha.
  itemCount  Int       @default(0)
  // "Possui desconto?" — marcado no formulario de Vendas quando as pecas de
  // campanha deste pedido sao vendidas com desconto. Muda a premiacao por item:
  //   Atacado: R$4,00 (sem) / R$2,00 (com) · Varejo: R$5,00 (sem) / R$2,50 (com).
  // Pedidos antigos ficam false (sem desconto = valor integral).
  campaignDiscount Boolean @default(false)

  orderValue Decimal @default(0) @db.Decimal(10, 2)
  freight    Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal @default(0) @db.Decimal(10, 2)

  // Comprovante enviado pela Vendedora na criacao do pedido.
  // MANTIDO por compatibilidade: pedidos antigos usam este campo unico.
  // Pedidos novos gravam ate 5 comprovantes na tabela OrderPaymentProof.
  paymentProofPath String?
  // Segundo comprovante, anexado pelo FINANCEIRO na Analise de Pedidos.
  // Obrigatorio para aprovar. Visivel a todos ao expandir o card no fluxo.
  paymentProof2Path String?
  invoicePath      String?

  // "Observacoes de Envio" na UI. Vai para a logistica/motorista.
  notes String?

  // Endereço de entrega — preenchido apenas quando a forma de envio exige
  // (ShippingMethod.requiresAddress = true, ex.: "Excursão"). Todos opcionais
  // no banco (pedidos de outras formas de envio não têm endereço); a
  // obrigatoriedade é validada no formulário quando a forma exige.
  shipCep         String?
  shipStreet      String?  // Logradouro
  shipNumber      String?  // Número
  shipDistrict    String?  // Bairro
  shipCity        String?  // Cidade
  shipState       String?  // UF
  // Excursao selecionada (opcional). So faz sentido quando a forma de envio e
  // a de Excursao; o endereco da excursao pre-preenche os campos ship* acima.
  excursao   Excursao? @relation(fields: [excursaoId], references: [id])
  excursaoId String?
  // "Observacoes de Pagamento": exclusivo do FINANCEIRO na aprovacao.
  // NAO e exibido para motorista/logistica.
  paymentNotes String?

  // Comentario do FINANCEIRO no card da coluna "Pagamento pendente".
  // Campo proprio (e NAO o paymentNotes acima) porque tem outro dono e outro
  // momento: e escrito/reescrito enquanto o recebimento nao e confirmado.
  // Editavel a qualquer momento; null = sem comentario.
  paymentPendingNote String?

  // Pendencia sinalizada pelo FINANCEIRO ("Qual o problema?").
  // - financeIssue: texto da inconsistencia (null = sem pendencia ativa).
  // - financeIssueAt: quando foi sinalizada.
  // - financeIssueResolvedAt: quando VENDAS marcou como resolvida
  //   (se preenchido com issue ainda presente, ficou resolvida; usamos os
  //    dois para saber se a pendencia esta ATIVA ou ja RESOLVIDA).
  financeIssue           String?
  financeIssueAt         DateTime?
  financeIssueResolvedAt DateTime?

  items         OrderItem[]
  campaignItems CampaignItem[]
  paymentProofs OrderPaymentProof[]
  financeProofs OrderFinanceProof[]
  delivery      Delivery?
  driverPayment DriverPayment?
  history       OrderStatusHistory[]
  pieceMovements PieceMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([pieceStatus])
  @@index([sellerId])
  @@index([customerId])
  @@index([createdAt])
  @@index([campaignId])
  @@index([cnpjId])
  @@index([excursaoId])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

// Comprovantes de pagamento enviados pela Vendedora no Novo Pedido.
// Um pedido aceita ate 5 (o limite e aplicado na action, nao no banco).
// Segue a regra do projeto: aqui vai apenas o CAMINHO do arquivo (.webp no
// disco), nunca o binario.
model OrderPaymentProof {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  filePath  String
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Comprovantes anexados pelo FINANCEIRO na Analise de Pedidos (ate 5).
// O PRIMEIRO tambem e espelhado em Order.paymentProof2Path, que continua
// sendo a trava de aprovacao (nao quebrar essa regra).
model OrderFinanceProof {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  filePath  String
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  changedBy String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ===========================================================================
// CONTROLE DE PECAS (Logistica > "Controle de Peças")
// Aplica-se apenas aos pedidos do tipo "10 - Peças p/ Blogueira".
// ===========================================================================

// Estados do Controle de Pecas.
//
// ORDEM DAS COLUNAS NO QUADRO (definida em src/lib/piece-control.ts):
//   Em Uso -> Reprocessamento -> Devolvido -> Finalizado
//
// EM_MANUTENCAO continua sendo o valor gravado no banco; o rotulo exibido
// passou a ser "Reprocessamento". Mesma decisao ja tomada em ENVIADO -> "Pronto":
// renomear o valor do enum exigiria reescrever historico e integracoes sem
// nenhum ganho funcional.
//
// FINALIZADO e o estado TERMINAL: so ao chegar nele o fluxo do pedido e
// considerado encerrado.
enum PieceStatus {
  EM_USO
  DEVOLVIDO
  EM_MANUTENCAO
  FINALIZADO
}

// Trilha de auditoria das movimentacoes do quadro de Controle de Pecas.
// Guarda de/para, observacao e quem moveu. Nunca sobrescrevemos: o estado
// atual vive em Order.pieceStatus e o historico completo vive aqui.
model PieceMovement {
  id        String       @id @default(cuid())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  // null quando e a PRIMEIRA entrada no controle (entrega registrada).
  fromStatus PieceStatus?
  toStatus   PieceStatus
  note       String?
  changedBy  String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ===========================================================================
// ENTREGA / MOTORISTAS
// ===========================================================================

enum DeliveryStatus {
  AGUARDANDO
  ATRIBUIDA
  EM_ROTA
  ENTREGUE
  FALHOU
}

model Delivery {
  id     String         @id @default(cuid())
  status DeliveryStatus @default(AGUARDANDO)

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  driver   User?   @relation("DeliveryDriver", fields: [driverId], references: [id])
  driverId String?

  assignedAt  DateTime?
  startedAt   DateTime?
  deliveredAt DateTime?
  failReason  String?

  proofs Proof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([driverId])
}

model Proof {
  id         String   @id @default(cuid())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String
  filePath   String
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  @@index([deliveryId])
}

// Pagamento da ENTREGA ao motorista (Financeiro > "Pagamentos de Motoristas").
// Registrado quando o Financeiro confirma o pagamento de um pedido ENTREGUE.
// Um pagamento por pedido (1-1). Guarda o valor pago, a chave PIX usada (copia
// no momento do pagamento, para nao mudar se o cadastro do motorista mudar
// depois) e quem confirmou. NUNCA movimenta dinheiro: e apenas o registro.
model DriverPayment {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique

  driver   User   @relation("DriverPaymentDriver", fields: [driverId], references: [id])
  driverId String

  // Valor da entrega pago ao motorista.
  amount   Decimal @db.Decimal(10, 2)
  // Chave PIX usada no pagamento (snapshot; pode diferir do cadastro atual).
  pixKey   String?
  // Usuario (Financeiro/Gestao) que confirmou o pagamento.
  confirmedById String?
  createdAt DateTime @default(now())

  @@index([driverId])
}

// ===========================================================================
// NOTIFICACOES
// ===========================================================================

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  message   String
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ===========================================================================
// METAS E CAMPANHAS (Rank de Vendas)
// ===========================================================================

// Meta financeira individual (por usuario, mes/ano, escopo).
// IMPORTANTE: a unicidade NAO usa @@unique aqui porque o Prisma nao suporta
// indice unico PARCIAL (com WHERE). A regra correta vive na migration SQL:
//   - Meta GERAL    (campaignId NULL):     unica por (user, mes, ano, escopo)
//   - Meta CAMPANHA (campaignId NOT NULL): unica por (user, mes, ano, escopo, campanha)
// Assim a Geral e as varias metas de Campanha convivem sem se sobrescrever.
model SalesGoal {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  amount    Decimal    @db.Decimal(12, 2) // meta em R$ (usada quando Geral)
  // Meta por quantidade de itens. Usada quando a meta é vinculada a Campanha.
  targetItems Int?
  month     Int        // 1-12
  year      Int
  scope     SalesModel // ATACADO ou VAREJO
  // null = meta Geral; preenchido = meta vinculada a uma Campanha.
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?
  createdAt DateTime   @default(now())

  @@index([userId, month, year])
  @@index([month, year])
  @@index([campaignId])
}

// AJUSTE MANUAL DO REALIZADO NO RANKING DE VENDAS.
//
// Existe para o caso em que a venda aconteceu mas o pedido NAO foi registrado
// na plataforma: sem isso o ranking mostraria um numero menor que o real e a
// vendedora apareceria abaixo da posicao dela.
//
// `amount` e o valor DIGITADO manualmente e SUBSTITUI o consolidado do periodo
// para aquele vendedor. `systemAmount` guarda quanto o sistema havia calculado
// no instante do ajuste — assim a tela consegue avisar quando novos pedidos
// entraram depois e o ajuste ficou defasado.
//
// Um registro por vendedor/mes/ano: o ajuste vale para os tres paineis (Geral,
// Varejo e Atacado), que sao recortes do MESMO numero.
model RankAdjustment {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  month  Int    // 1-12
  year   Int
  // Valor manual do realizado, em R$.
  amount       Decimal @db.Decimal(12, 2)
  // Consolidado pelo sistema no momento em que o ajuste foi salvo.
  systemAmount Decimal @db.Decimal(12, 2) @default(0)
  // CORTE do ajuste: instante ate o qual `amount` responde pelo realizado.
  // Pedidos criados a partir daqui NAO sao substituidos pelo ajuste — eles
  // SOMAM sobre ele. Null = ajuste anterior a esta regra; nesse caso o corte
  // usado e a constante AJUSTE_CORTE_PADRAO (ver src/lib/rank-data.ts).
  baselineAt   DateTime?
  note      String?
  changedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([month, year])
}

// Campanha: apenas o nome (cadastro simples). As metas vinculadas
// a ela ficam em SalesGoal (campo campaignId).
model Campaign {
  id         String   @id @default(cuid())
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  orders Order[]
  goals  SalesGoal[]
  items  CampaignItem[]
}

// Item de campanha lançado dentro de um pedido. Permite MÚLTIPLAS referências
// de campanha por pedido, cada uma com sua quantidade e valor próprios.
// Substitui a semântica antiga do par (Order.campaignId + Order.itemCount),
// que só comportava UMA campanha por pedido. Os campos legados no Order são
// mantidos por compatibilidade e alimentados com os agregados destes itens.
model CampaignItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  // "Referência" da peça de campanha (texto livre informado no pedido).
  reference String
  quantity  Int      @default(0)
  // Valor (R$) registrado individualmente para este item de campanha.
  // É esta soma que alimenta a coluna "Valor" no Rank > Performance na Campanha.
  value     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([campaignId])
}

// ===========================================================================
// TAREFAS DIARIAS (Kanban da vendedora)
// ===========================================================================

// Status do quadro de tarefas: A Fazer -> Fazendo -> Concluida.
enum TaskStatus {
  A_FAZER
  FAZENDO
  CONCLUIDA
}

// Tarefa diaria de uma vendedora. Kanban pessoal (cada uma ve as proprias;
// a Gestao ve todas). "category" e texto livre digitado pela vendedora.
model DailyTask {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  // Horarios do dia em texto "HH:MM" (simples; a tarefa e do dia corrente).
  startTime String?
  endTime   String?
  category  String?
  notes     String?
  status    TaskStatus @default(A_FAZER)
  // Ordem manual dentro da coluna (para reordenacao futura; menor = topo).
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

// ===========================================================================
// TEMPO REAL (polling) — eventos de pedido persistidos
// ===========================================================================

// Fila curta de eventos para o polling do dashboard. As Server Actions inserem
// uma linha a cada criacao/mudanca de pedido; o endpoint /api/events/poll le os
// eventos posteriores ao ultimo timestamp que o cliente ja viu.
//
// Por que no banco e nao em memoria: no container standalone do Next, a Server
// Action e o route handler do poll nao compartilham o mesmo estado de modulo,
// entao um buffer em memoria nunca "casa". O Postgres e o canal compartilhado.
//
// Limpeza: linhas antigas sao descartaveis (o cliente so olha os ultimos
// segundos). Um DELETE periodico evita crescimento — ver realtime/bus.ts.
model RealtimeEvent {
  id            String   @id @default(cuid())
  type          String
  orderId       String
  orderNumber   String?
  customerName  String?
  status        String?
  originStoreId String?
  notifyRoles   String[] @default([])
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ===========================================================================
// WHATSAPP (notificacao de motoristas via Baileys)
// ===========================================================================

// Estado de autenticacao do Baileys. Uma linha por chave.
// `id` = "creds" ou "<tipo>:<id>" (pre-key, session, app-state-sync-key, ...).
// Fica no banco, e nao em disco, para sobreviver a recriacao do container:
// todo deploy do EasyPanel monta um container novo.
model WhatsappSession {
  id        String   @id
  // JSON serializado com BufferJSON do Baileys (contem Buffer/Uint8Array).
  data      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Configuracao do canal. Linha unica ("singleton").
model WhatsappConfig {
  id        String   @id @default("singleton")
  // Interruptor de envio. Nasce FALSE: nada e enviado ate alguem parear o
  // numero e ligar deliberadamente na tela de Gestao.
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Concessao de instancia unica. Duas conexoes com a mesma credencial se
// derrubam e colocam o numero em risco de bloqueio, entao so um processo
// conecta. Linha unica ("singleton").
model WhatsappLock {
  id          String   @id @default("singleton")
  instanceId  String
  heartbeatAt DateTime

  // Estado observavel publicado pelo processo que detem a conexao.
  // Fica AQUI, e nao so em memoria, porque o Next compila o modulo da conexao
  // em bundles diferentes (instrumentacao x Server Action) e, com varias
  // replicas, o painel pode ser servido por um processo que nao e o dono da
  // conexao. Mesmo motivo pelo qual o bus de tempo real vive no banco.
  state           String   @default("DESCONECTADO")
  // QR corrente. E publico por natureza (vira imagem na tela) e some assim que
  // o pareamento conclui. NAO e credencial — estas ficam em WhatsappSession.
  qr              String?
  connectedNumber String?
}

enum WhatsappSendStatus {
  ENVIADO
  FALHOU
  // Numero ausente ou invalido: nao houve tentativa de envio.
  IGNORADO
}

// Log por destinatario. NUNCA guarda o numero inteiro.
// Sem relacao Prisma com Order/User de proposito: e registro historico e nao
// deve impedir a exclusao de um pedido ou usuario (deleteOrder apaga de fato).
model WhatsappSendLog {
  id          String             @id @default(cuid())
  orderId     String?
  userId      String
  // 4 ultimos digitos, para conferencia sem expor o numero.
  phoneSuffix String?
  status      WhatsappSendStatus
  error       String?
  createdAt   DateTime           @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
}
